with "config/tabula_config.gpr";
with "ada_toml";
with "sml";

--  Tabula: tables in and out -- TOML read and written, CSV read and
--  written.  src/core holds the SPARK-proven pure units (decimal shape
--  and scale, the text of TOML scalars, the CSV scanner, an sml machine);
--  src/app holds the IO: the ada_toml adapter (typed knob getters with
--  fallbacks), the TOML writer and the CSV reader and writer.
--  proof/proof.gpr sources src/core directly and withs only sml, keeping
--  foreign code out of the proof tree.
project Tabula is

   for Library_Name use "Tabula";
   for Library_Version use
     Project'Library_Name & ".so." & Tabula_Config.Crate_Version;

   for Source_Dirs use ("src/core", "src/app", "config");
   for Object_Dir use "obj/" & Tabula_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("TABULA_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Tabula_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Tabula;
