with "config/tabula_config.gpr";
with "ada_toml";

--  Tabula: narrow TOML reading for configuration files.  src/core holds
--  the SPARK-proven decimal shape check (pure, zero IO, no dependencies
--  beyond other core units); src/app holds the ada_toml adapter (typed
--  knob getters with fallbacks; absence is silent, a present-but-wrong
--  value warns through the caller's handler and falls back).
--  proof/proof.gpr sources src/core directly and withs nothing, keeping
--  foreign code out of the proof tree.
project Tabula is

   for Library_Name use "Tabula";
   for Library_Version use
     Project'Library_Name & ".so." & Tabula_Config.Crate_Version;

   for Source_Dirs use ("src/core", "src/app", "config");
   for Object_Dir use "obj/" & Tabula_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("TABULA_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Tabula_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Tabula;
