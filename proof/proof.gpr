with "sml";

--  SPARK proof target.  Not built by `alr build`; analysed with
--  `alr exec -- gnatprove -P proof/proof.gpr`.
--
--  Sources the SPARK core directly (rather than withing tabula.gpr)
--  because the Alire-generated config gpr withs every dependency's
--  project, which would drag the adapter's foreign code (ada_toml) into
--  the proof tree.  This tree is exactly the proof harnesses + src/core
--  + sml, whose machine the CSV scanner instantiates, mirroring
--  sml-ada's proof setup.
project Proof is

   for Source_Dirs use ("src", "../src/core");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;

end Proof;
